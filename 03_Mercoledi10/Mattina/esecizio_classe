#------------------------- ESERCIZIO  AVANZATO -------------------------------------
class Garage():
    def __init__(self,capienza,auto_presenti):
        self.capienza = capienza
        self.auto_presenti = auto_presenti []


# METODO PARCHEGGIA
    def parcheggia(self, targa):                   #Per parcheggiare salviamo la targa 
        if targa in self.auto_presenti:            #controlliamo se abbiamo in lista la tarrga 
            print("L'auto è gia parcheggiata nel garage")
        elif len(self.auto_presenti) >= self.capienza:   #Controllo se c'è spazio o il garage è pieno
            print("Il garage è pieno, è impossibile parcheggiare l'auto")
        else:
            self.auto_presenti.append(targa)            #Inserisco la targa nella lista delle auto presenti 
            print("La tua auto è stata parcheggiata")      
# METODO RIMUOVI
    def rimuovi(self, targa):
        if targa in self.auto_presenti:         #Controllo se la targa è presente neella lista 
            self.auto_presenti.remove(targa)    #Rimuovo l'auto 
            print("Hai ritirato la tua auto")
        else:
            print("L'auto non è nel garage")
            
# METODO POSTI LIBERI
    def posti_liberi(self):
        posti_disponibili = self.capienza - len(self.auto_presenti)  #Variabile osti disponibili = capienza - elementi presenti nella lista 
        return posti_disponibili
    

garage = Garage(5)    #Indico la capienza massima 

print("Posti liberi iniziali: " , garage.posti_liberi())  #Controllo quante auto ho adesso

garage.parcheggia("AA111AA")    #Prima auto parcheggiata 
garage.parcheggia("AA111AA")  #Parcheggio di nuovo la stessa auto 

garage.parcheggia("BB222BB")   #2 auto 

print("Posti liberi: " , garage.posti_liberi())  #Quati posti liberi ci sono adesso 

garage.rimuovi("AA111AA")    #Esce un'auto 
print("Posti liberi: " , garage.posti_liberi())  #Quati posti liberi ci sono adesso 


