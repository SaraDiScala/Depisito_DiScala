class Punto:
    coordinate_iniziali = (0,0)     #Imposto attributo iniziale
    def __init__(self,x,y):
        self.x = x
        self.y = y
    
dx = int(input("Inserire un valore x: "))       #Creo varibili per richiedere i valori da inserire nell'oggetto
dy = int(input("Inserire un valore y : "))

coordinate = Punto(dx,dy)                      #Creo l'oggetto con i valori ricevuti dalle variabili dx e dy (richiamando classe)
print("Le coordinate inziiali sono: ", coordinate.coordinate_iniziali)  #richiamo l'attributo della classe in riferimento a quell'ggetto
print("Le tue coordinate sono: ", coordinate.x, coordinate.y)       #richiamo oggetto e valori singoli 



