class ContoCorrente:  
#Istanza 
    def __init__(self,intestatario,saldo = 0):    #Attributi istanza con valore di default 
        self.intestatario = intestatario
        self.saldo = saldo
        
#Metodo deposita      
    def deposita(self, importo):     #Funzione per effettuare il deposito 
        if importo <= 0:                  #Se importo negativo o 0 , stampa errore
            print("Importo non valido")
        else:
            self.saldo += importo  #Altrimenti incrementa il saldo con valore di importo 
            print("Deposito avvenuto correttamente. Il suo saldo aggiornato è: ", self.saldo)
#Metodo preleva 
    def preleva(self, prelievo):
        if prelievo > 0:
            self.saldo -= prelievo
            print("Prelievo avvenuto correttamente. Il suo saldo aggiornato è: ", self.saldo)
        elif self.saldo < prelievo:
            print("Il saldo non è sufficiente")
        else:
            prelievo <= 0
            print("Operazione non consentita")

                    
#Metodo stampa
    def stampa_saldo(self):          #Richiamo la classe stessa
        print("Il saldo di",self.intestatario , "è: ",self.saldo, "€")   #stampo messaggio riportando i parametri della classe
        
        
# TEST 
