print(len(squadra1))

class Moltiplicatore:
    def __init__(self,numero):
        self.numero = numero
        
    def __call__(self,valore):       #Richiamo l'oggetto 
        return valore*self.numero
    
doppio = Moltiplicatore(2)     #Istanzio oggetto - si passa solo un valore (attributo)
print(doppio(10))     #Si tratta di un oggetto che "viene" trattao come funzione


class Prodotto:
    
    def __init__(self, nome , prezzo):
        self.nome = nome
        self.prezzo = prezzo
        
    def__eq__(self, altro):     #Confronto tra oggetti - se sono uguali o no
        return self.nome == altro.nome and self.prezzo == altro.prezzo
    
prodotto1 = Prodotto("Mouse", 20)
prodotto2 = Prodotto("Mouse", 20)
prodotto3 = Prodotto("Tastiera", 35)

print(prodotto1 == prodotto2)   #True
print(prodotto1 == prodotto3)   #False
